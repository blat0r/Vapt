<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vapt.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vapt">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnTitleBarBackRequested"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <!-- Só o nome, sem ícone: mais limpo. O ícone continua na barra de tarefas. -->
            <TitleBar.LeftHeader>
                <TextBlock
                    Margin="6,0,0,1"
                    VerticalAlignment="Center"
                    CharacterSpacing="20"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Vapt" />
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <Border
                    x:Name="AdminBadge"
                    Margin="0,0,8,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xEA18;" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Administrador" />
                    </StackPanel>
                </Border>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
        </NavigationView>
    </Grid>
</Window>

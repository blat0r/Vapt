<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vapt.Controls">

    <Grid Padding="24,16,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título e escolha do que analisar. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Espaço em disco" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Veja o que ocupa espaço. Duplo clique amplia uma pasta; botão direito traz as ações." />
            </StackPanel>
            <ComboBox
                x:Name="DriveBox"
                Grid.Column="1"
                MinWidth="220"
                VerticalAlignment="Center"
                PlaceholderText="Unidade" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnPickFolder"
                ToolTipService.ToolTip="Analisar uma pasta">
                <FontIcon FontSize="16" Glyph="&#xE8DA;" />
            </Button>
            <Button
                x:Name="ScanButton"
                Grid.Column="3"
                MinWidth="120"
                VerticalAlignment="Center"
                Click="OnScan"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ScanIcon" FontSize="14" Glyph="&#xE721;" />
                    <TextBlock x:Name="ScanText" Text="Analisar" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Navegação, caminho e filtro. -->
        <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBack" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Voltar (Alt+←)">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Click="OnForward" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Avançar (Alt+→)">
                <FontIcon FontSize="14" Glyph="&#xE72A;" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Click="OnUp" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Pasta acima">
                <FontIcon FontSize="14" Glyph="&#xE74A;" />
            </Button>
            <Button x:Name="HomeButton" Grid.Column="3" Click="OnHome" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Início da análise">
                <FontIcon FontSize="14" Glyph="&#xE80F;" />
            </Button>
            <BreadcrumbBar
                x:Name="Breadcrumb"
                Grid.Column="4"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                ItemClicked="OnBreadcrumbClicked" />
            <TextBox
                x:Name="FilterBox"
                Grid.Column="5"
                VerticalAlignment="Center"
                PlaceholderText="Filtro: *.mp4; &gt;1gb; &lt;30dias; |*.tmp"
                TextChanged="OnFilterChanged" />
        </Grid>

        <ProgressBar x:Name="ScanProgress" Grid.Row="2" Visibility="Collapsed" />

        <!-- Mapa + painel lateral. -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <controls:TreemapView x:Name="Map" Margin="6" />
                    <!-- Estado vazio. -->
                    <StackPanel
                        x:Name="EmptyState"
                        MaxWidth="380"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xEDA2;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Escolha uma unidade e clique em Analisar" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="O mapa aparece na hora e vai se completando enquanto a varredura anda. Quanto maior o bloco, mais espaço ele ocupa."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Painel: item sob o mouse, legenda e maiores arquivos. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="InfoName"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Nada selecionado"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="InfoSize"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="InfoDetail"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                x:Name="InfoActions"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <Button Click="OnRevealSelected" ToolTipService.ToolTip="Mostrar no Explorador de Arquivos">
                                    <FontIcon FontSize="14" Glyph="&#xEC50;" />
                                </Button>
                                <Button Click="OnZoomSelected" ToolTipService.ToolTip="Ampliar">
                                    <FontIcon FontSize="14" Glyph="&#xE71E;" />
                                </Button>
                                <Button Click="OnDeleteSelected" ToolTipService.ToolTip="Excluir">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Por tipo" />
                            <StackPanel x:Name="LegendPanel" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Maiores arquivos aqui" />
                            <ListView
                                x:Name="LargestList"
                                Margin="-12,0,-12,0"
                                IsItemClickEnabled="True"
                                ItemClick="OnLargestClicked"
                                SelectionMode="None" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Barra de estado. -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="HoverText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Page>

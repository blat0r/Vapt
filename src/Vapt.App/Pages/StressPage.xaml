<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.StressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel x:Name="Body" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Stress test" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Carga máxima para ver se o PC aguenta sem travar e sem esquentar demais: bom depois de montar, trocar pasta térmica ou fazer overclock. Para sozinho no limite de temperatura."
                    TextWrapping="Wrap" />
            </StackPanel>

            <tk:SettingsCard Description="Todas as threads em contas de ponto flutuante (AVX), o que mais esquenta." Header="Processador">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE950;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Parar em" />
                    <ComboBox x:Name="CpuLimit" MinWidth="90" SelectedIndex="1">
                        <ComboBoxItem Content="85 °C" />
                        <ComboBoxItem Content="90 °C" />
                        <ComboBoxItem Content="95 °C" />
                    </ComboBox>
                    <ToggleSwitch x:Name="CpuToggle" IsOn="True" OffContent="" OnContent="" MinWidth="0" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Description="Cena 3D pesada numa janela, como o FurMark: GPU a 100%." Header="Placa de vídeo">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Parar em" />
                    <ComboBox x:Name="GpuLimit" MinWidth="90" SelectedIndex="1">
                        <ComboBoxItem Content="80 °C" />
                        <ComboBoxItem Content="85 °C" />
                        <ComboBoxItem Content="90 °C" />
                    </ComboBox>
                    <ToggleSwitch x:Name="GpuToggle" IsOn="True" OffContent="" OnContent="" MinWidth="0" />
                </StackPanel>
            </tk:SettingsCard>
            <tk:SettingsCard Description="Para checar estabilidade, 15 minutos é um bom começo; 60 para ter certeza." Header="Duração">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="Duration" MinWidth="140" SelectedIndex="1">
                        <ComboBoxItem Content="5 minutos" />
                        <ComboBoxItem Content="15 minutos" />
                        <ComboBoxItem Content="30 minutos" />
                        <ComboBoxItem Content="60 minutos" />
                    </ComboBox>
                    <Button x:Name="StartButton" MinWidth="120" Click="OnStart" Style="{StaticResource AccentButtonStyle}">
                        <TextBlock x:Name="StartText" Text="Começar" />
                    </Button>
                </StackPanel>
            </tk:SettingsCard>

            <Border x:Name="LivePanel" Margin="0,12,0,0" Padding="20" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Tempo" />
                            <TextBlock x:Name="ElapsedText" Style="{StaticResource SubtitleTextBlockStyle}" Text="0:00" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="CPU" />
                            <TextBlock x:Name="CpuNow" Foreground="#FFE8743B" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                            <TextBlock x:Name="CpuMaxText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="GPU" />
                            <TextBlock x:Name="GpuNow" Foreground="#FF3B82D6" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                            <TextBlock x:Name="GpuMaxText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="FPS da GPU" />
                            <TextBlock x:Name="FpsText" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                        </StackPanel>
                    </Grid>
                    <!-- Gráfico de temperatura (últimos 5 minutos). -->
                    <Grid Height="140">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />
                        <Canvas x:Name="Chart" SizeChanged="OnChartSize">
                            <Polyline x:Name="CpuLine" Stroke="#FFE8743B" StrokeThickness="2" />
                            <Polyline x:Name="GpuLine" Stroke="#FF3B82D6" StrokeThickness="2" />
                        </Canvas>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="100 °C" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="30 °C" />
                    </Grid>
                    <TextBlock x:Name="LogText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ResultBar" Margin="0,8,0,0" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel x:Name="Body" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Reparar" />
            <TextBlock
                Margin="0,4,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Consertos para quando o Windows está estranho: arquivos corrompidos, ícones errados, internet travando. Tudo com as ferramentas do próprio Windows."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Windows" />
            <tk:SettingsCard x:Name="SfcCard" Description="Confere todos os arquivos do sistema e troca os corrompidos (SFC). Leva de 5 a 15 minutos." Header="Verificar arquivos do sistema">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D5;" />
                </tk:SettingsCard.HeaderIcon>
                <Button x:Name="SfcButton" Click="OnSfc" Content="Verificar" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="DismCard" Description="Baixa do Windows Update as peças boas da imagem do Windows (DISM). Use se o SFC não conseguir consertar." Header="Reparar a imagem do Windows">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;" />
                </tk:SettingsCard.HeaderIcon>
                <Button x:Name="DismButton" Click="OnDism" Content="Reparar" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="IconCard" Description="Para ícones em branco, errados ou miniaturas que não aparecem. O Explorador pisca e volta." Header="Refazer cache de ícones">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Click="OnIconCache" Content="Refazer" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="ExplorerCard" Description="Quando a barra de tarefas ou o menu Iniciar travam." Header="Reiniciar o Explorador">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Click="OnRestartExplorer" Content="Reiniciar" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Internet" />
            <tk:SettingsExpander x:Name="DnsCard" Description="Trocar o DNS pode deixar sites abrindo mais rápido e bloquear golpes ou anúncios." Header="Servidor DNS" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </tk:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="DnsCurrent" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel x:Name="DnsOptions" />
                </tk:SettingsExpander.ItemsHeader>
            </tk:SettingsExpander>
            <tk:SettingsCard x:Name="FlushCard" Description="Resolve site que &quot;não abre&quot; depois de mudar de endereço." Header="Limpar cache de DNS">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Click="OnFlushDns" Content="Limpar" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="NetResetCard" Description="Redefine Winsock e TCP/IP quando a internet some sem motivo. As redes Wi-Fi salvas continuam. Pede reiniciar." Header="Redefinir a rede">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </tk:SettingsCard.HeaderIcon>
                <Button x:Name="NetResetButton" Click="OnNetReset" Content="Redefinir" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Energia" />
            <tk:SettingsCard x:Name="PowerCard" Description="Em PC de mesa, &quot;Alto desempenho&quot; ou &quot;Desempenho Máximo&quot; evitam que o processador economize na hora errada." Header="Plano de energia">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE945;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PowerBox" MinWidth="220" SelectionChanged="OnPowerChanged" />
                    <Button x:Name="UltimateButton" Click="OnUltimate" Content="Criar Desempenho Máximo" Visibility="Collapsed" />
                </StackPanel>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>

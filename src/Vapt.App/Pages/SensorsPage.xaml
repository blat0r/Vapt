<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" MaxWidth="{StaticResource PageMaxWidth}" Margin="36,24,36,8" Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sensores" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Temperatura, clock, uso, consumo, ventoinhas e voltagens de cada peça, atualizados a cada segundo. Valores mínimos e máximos desde que a página abriu."
                TextWrapping="Wrap" />
            <Grid x:Name="Tiles" Margin="0,8,0,0" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Filters" Orientation="Horizontal" Spacing="6" />
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="220"
                    PlaceholderText="Buscar sensor"
                    QueryIcon="Find"
                    TextChanged="OnSearch" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="36,0,36,36">
            <Grid MaxWidth="{StaticResource PageMaxWidth}">
                <ProgressRing x:Name="Ring" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsActive="True" />
                <StackPanel x:Name="Groups" Spacing="12" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" MaxWidth="{StaticResource PageMaxWidth}" Margin="36,24,36,8" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Debloat" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Tire o que o Windows colocou sem você pedir: apps, anúncios, coleta de dados e IA. Tudo pode voltar: apps pela Microsoft Store, o resto por aqui."
                TextWrapping="Wrap" />
            <SelectorBar x:Name="Tabs" Margin="-12,8,0,0" SelectionChanged="OnTabChanged">
                <SelectorBarItem IsSelected="True" Text="Visão geral" />
                <SelectorBarItem Text="Apps" />
                <SelectorBarItem Text="Anúncios" />
                <SelectorBarItem Text="Privacidade" />
                <SelectorBarItem Text="IA e Recall" />
                <SelectorBarItem Text="Serviços" />
            </SelectorBar>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="36,0,36,36">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">
                <InfoBar x:Name="StatusBar" IsClosable="True" />

                <!-- Visão geral -->
                <StackPanel x:Name="OverviewPanel" Spacing="{StaticResource SettingsCardSpacing}">
                    <Border Margin="0,0,0,8" Padding="24,20" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Debloat recomendado" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Faz de uma vez só o que é seguro e reversível, como o modo padrão do Win11Debloat. O que tem &quot;Atenção&quot; fica de fora e você decide nas abas."
                                    TextWrapping="Wrap" />
                                <StackPanel x:Name="PlanList" Margin="0,8,0,0" Spacing="6" />
                                <ProgressBar x:Name="PlanBusy" Margin="0,8,0,0" IsIndeterminate="True" />
                            </StackPanel>
                            <Button
                                x:Name="ApplyPlanButton"
                                Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Top"
                                Click="OnApplyPlan"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE945;" />
                                    <TextBlock x:Name="ApplyPlanText" Text="Aplicar o recomendado" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Por categoria" />
                    <StackPanel x:Name="CategoryCards" Spacing="{StaticResource SettingsCardSpacing}" />
                </StackPanel>

                <!-- Apps -->
                <StackPanel x:Name="AppsPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                    <Border Margin="0,0,0,8" Padding="24,18" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="AppsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Procurando bloatware…" />
                                <TextBlock
                                    x:Name="AppsSubtitle"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <ProgressBar x:Name="AppsBusy" Margin="0,8,0,0" IsIndeterminate="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnSelectRecommended" Content="Marcar recomendados" />
                                <Button x:Name="RemoveButton" MinWidth="150" Click="OnRemove" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock x:Name="RemoveText" Text="Remover" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="AppGroups" Spacing="{StaticResource SettingsCardSpacing}" />
                    <StackPanel x:Name="RemovedPanel" Spacing="{StaticResource SettingsCardSpacing}" />
                </StackPanel>

                <!-- Anúncios -->
                <StackPanel x:Name="AdsPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed" />

                <!-- Privacidade: ajustes + serviços e tarefas de telemetria -->
                <StackPanel x:Name="PrivacyPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed" />

                <!-- IA e Recall -->
                <StackPanel x:Name="AiPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                    <Border Margin="0,0,0,8" Padding="24,18" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="52"
                                Height="52"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="26">
                                <FontIcon FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE722;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="RecallTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Recall" />
                                <TextBlock
                                    x:Name="RecallText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Serviços em segundo plano -->
                <StackPanel x:Name="ServicesPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="Lista curta de propósito: só recursos que pouca gente usa. &quot;Manual&quot; quer dizer que o serviço só abre quando algo precisa dele. Busca, Windows Update, Defender, Xbox e áudio não entram aqui."
                        Severity="Informational"
                        Title="Por que tão poucos?" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel x:Name="Body" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Overlay de FPS" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="FPS, tempo de quadro, 1% low, GPU e CPU num cantinho da tela enquanto você joga. Mede pelo próprio Windows, sem injetar nada no jogo (sem risco de anticheat)."
                    TextWrapping="Wrap" />
            </StackPanel>

            <tk:SettingsCard Description="Atalho: Ctrl + Shift + O mostra e esconde durante o jogo. Funciona em janela e janela sem borda (em tela cheia exclusiva o Windows não deixa nada por cima)." Header="Mostrar overlay">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RunToggle" Toggled="OnRun" />
            </tk:SettingsCard>
            <tk:SettingsCard Description="O overlay já liga quando o Vapt abre." Header="Ligar ao abrir o Vapt">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartToggle" Toggled="OnStartToggle" />
            </tk:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="O que mostrar" />
            <tk:SettingsExpander Description="Marque o que aparece no overlay." Header="Itens" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.ItemsHeader>
                    <Grid x:Name="Items" Padding="56,8,16,12" ColumnSpacing="24" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </tk:SettingsExpander.ItemsHeader>
            </tk:SettingsExpander>
            <tk:SettingsCard Header="Posição">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B3;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="CornerBox" MinWidth="200" SelectionChanged="OnCorner">
                    <ComboBoxItem Content="Canto superior esquerdo" />
                    <ComboBoxItem Content="Canto superior direito" />
                    <ComboBoxItem Content="Canto inferior esquerdo" />
                    <ComboBoxItem Content="Canto inferior direito" />
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="Tamanho">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8E9;" />
                </tk:SettingsCard.HeaderIcon>
                <Slider x:Name="ScaleSlider" Width="200" Maximum="1.75" Minimum="0.75" StepFrequency="0.05" ValueChanged="OnScale" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>

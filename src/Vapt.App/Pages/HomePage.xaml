<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- Botão claro sobre o destaque escuro (funciona com qualquer cor de destaque). -->
        <Style x:Key="HeroPrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#FF141414" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style x:Key="HeroSecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="0,24,0,0" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Check-up: escuro → cor de destaque do Windows. -->
            <Grid
                MinHeight="236"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF0E0E12" />
                        <GradientStop Offset="0.5" Color="{ThemeResource SystemAccentColorDark3}" />
                        <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark1}" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid Padding="28,24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="Greeting" Foreground="#CCFFFFFF" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Olá!" />
                            <TextBlock x:Name="MachineText" Foreground="#99FFFFFF" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="VerdictText"
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Foreground="White"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Analisando seu PC…"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="HeroText"
                            Grid.Row="2"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Foreground="#D9FFFFFF"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Olhando arquivos inúteis, apps pré-instalados, inicialização, privacidade e espaço em disco."
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FixAllButton" Click="OnFixAll" IsEnabled="False" Style="{StaticResource HeroPrimaryButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE945;" />
                                    <TextBlock x:Name="FixAllText" FontWeight="SemiBold" Text="Vapt vupt" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RescanButton" Click="OnRescan" Style="{StaticResource HeroSecondaryButton}" ToolTipService.ToolTip="Analisar de novo">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Nota. -->
                    <Grid Grid.Column="1" Width="148" Height="148" VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="ScoreRing"
                            Width="148"
                            Height="148"
                            Background="#2EFFFFFF"
                            Foreground="White"
                            IsActive="True"
                            IsIndeterminate="True"
                            Maximum="100" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="ScoreText"
                                HorizontalAlignment="Center"
                                FontSize="44"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="" />
                            <TextBlock
                                x:Name="ScoreCaption"
                                HorizontalAlignment="Center"
                                Foreground="#B3FFFFFF"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- O que o check-up encontrou. -->
            <StackPanel x:Name="FindingsPanel" Margin="0,4,0,0" Spacing="{StaticResource SettingsCardSpacing}" />

            <!-- Medidores. -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Agora" />
            <Grid x:Name="Meters" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Processador" />
                        <TextBlock x:Name="CpuValue" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                        <ProgressBar x:Name="CpuBar" Maximum="100" />
                        <TextBlock x:Name="CpuName" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Memória" />
                        <TextBlock x:Name="RamValue" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                        <ProgressBar x:Name="RamBar" Maximum="100" />
                        <TextBlock x:Name="RamDetail" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DiskTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Disco do sistema" />
                        <TextBlock x:Name="DiskValue" Style="{StaticResource SubtitleTextBlockStyle}" Text="—" />
                        <ProgressBar x:Name="DiskBar" Maximum="100" />
                        <TextBlock x:Name="DiskDetail" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Ferramentas" />
            <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            </Grid>

            <TextBlock
                x:Name="FooterText"
                Margin="1,16,0,0"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>

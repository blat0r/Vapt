<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vapt.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel x:Name="Body" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" Text="Limpeza" />

            <!-- Resumo -->
            <Border Margin="0,0,0,8" Padding="24,20" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TotalText" Style="{StaticResource TitleLargeTextBlockStyle}" Text="—" />
                        <TextBlock
                            x:Name="SummaryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Analisando o que pode ser apagado com segurança…"
                            TextWrapping="Wrap" />
                        <ProgressBar x:Name="Busy" Margin="0,10,0,0" IsIndeterminate="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RescanButton" Click="OnRescan" ToolTipService.ToolTip="Analisar de novo">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                        <Button x:Name="CleanButton" MinWidth="140" Click="OnClean" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEA99;" />
                                <TextBlock Text="Limpar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="O que limpar" />
            <StackPanel x:Name="ItemsPanel" Spacing="{StaticResource SettingsCardSpacing}" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Avançado" />
            <tk:SettingsCard
                x:Name="DismCard"
                Description="Remove versões antigas de componentes que o Windows guarda após atualizações (pasta WinSxS), pelo DISM. Pode levar vários minutos."
                Header="Limpeza de componentes do Windows">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE912;" />
                </tk:SettingsCard.HeaderIcon>
                <Button x:Name="DismButton" Click="OnDism" Content="Executar" />
            </tk:SettingsCard>

            <InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="O Vapt não mexe no registro, no Prefetch, em cookies ou senhas e não promete &quot;liberar RAM&quot;: isso não deixa o PC mais rápido e às vezes atrapalha."
                Severity="Informational"
                Title="Só o que é lixo de verdade" />
        </StackPanel>
    </ScrollViewer>
</Page>

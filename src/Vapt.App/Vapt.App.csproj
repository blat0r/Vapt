<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Vapt</RootNamespace>
    <AssemblyName>Vapt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Vapt.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- App não empacotado (sem MSIX); usa o Windows App Runtime instalado no sistema. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Main próprio (Program.cs) para o Velopack tratar os argumentos do instalador primeiro. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Instalador: tudo junto (.NET e Windows App Runtime), funciona em qualquer Windows 11. -->
  <PropertyGroup Condition="'$(VaptRelease)' == 'true'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vapt.Core\Vapt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\Vapt.ico" Link="Assets\Vapt.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\Vapt.png" Link="Assets\Vapt.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
